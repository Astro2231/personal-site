---
// Shared frame for every project page in src/pages/projects/.
// The title and cover image come from src/data/projects.ts (the same entry the
// homepage card uses); the page's own content goes in the slot.
import Base from './Base.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const project = projects.find((p) => p.slug === slug);
if (!project) {
  throw new Error(`No project with slug "${slug}" in src/data/projects.ts`);
}
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`${project.title} — ${site.name}`}>
  <a class="back" href={`${base}#projects`}>← All projects</a>
  <h1 class="page-title">{project.title}</h1>
  {
    project.image ? (
      <img class="media cover" src={`${base}${project.image}`} alt={project.imageAlt ?? ''} />
    ) : (
      <div class="media cover placeholder">Coming soon</div>
    )
  }
  <article>
    <slot />
  </article>
</Base>

<style>
  .back { margin-bottom: 16px; }
  .page-title {
    padding-bottom: 12px;
    border-bottom: 2px solid var(--rule);
    margin-bottom: 24px;
  }
  .cover {
    max-width: 820px;
    margin-bottom: 28px;
  }
  article { max-width: 46rem; }
  article :global(.todo) { font-style: italic; }
  article :global(h2) {
    color: var(--heading);
    font-size: 1.3rem;
    font-weight: 700;
    margin: 32px 0 8px;
  }
</style>
