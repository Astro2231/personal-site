---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`${site.name} — Portfolio`}>
  <header class="hero">
    <div class="hero-text">
      <h1 class="page-title">{site.name}</h1>
      <p>{site.intro}</p>
      <a class="button" href={`${base}resume/`}>Resume</a>
    </div>
    {
      site.heroImage ? (
        <img class="hero-image" src={`${base}${site.heroImage}`} alt={site.heroImageAlt} />
      ) : (
        <div class="hero-image placeholder">Coming soon</div>
      )
    }
    <p class="hero-note">*website under construction</p>
  </header>

  <section id="projects" aria-label="Projects">
    <ul class="grid">
      {
        projects.map((p) => (
          <li>
            <a class="card" href={`${base}projects/${p.slug}/`}>
              {p.image ? (
                <img class="media card-image" src={`${base}${p.image}`} alt={p.imageAlt ?? ''} />
              ) : (
                <div class="media card-image placeholder">Coming soon</div>
              )}
              <span class="card-title rule-top">{p.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<script>
  // Keep the hero photo as tall as the text next to it.
  const hero = document.querySelector<HTMLElement>('.hero');
  const text = document.querySelector<HTMLElement>('.hero-text');
  if (hero && text) {
    new ResizeObserver(() => {
      hero.style.setProperty('--hero-h', `${text.offsetHeight}px`);
    }).observe(text);
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    align-items: start;
    margin-bottom: 72px;
  }
  .hero-text p {
    margin: 0 0 24px;
    max-width: 34rem;
  }
  /* Square photo sized to the height of the text beside it (--hero-h is set
     by the script below; 320px is the fallback before it runs). */
  .hero-image {
    width: var(--hero-h, 320px);
    max-width: 100%;
    aspect-ratio: 1 / 1;
    justify-self: end;
    margin-right: 300px; /* OFFSET: moves the photo 300px left of its column's right edge */
    object-fit: cover;
    object-position: center 15%;
    border-radius: 50%;
  }
  /* Note in the space the OFFSET above leaves right of the photo. Its text
     style is inherited from the page, same as the intro under the name. */
  .hero-note {
    position: absolute;
    top: 0;
    right: 0;
    width: 276px;
    height: var(--hero-h, 320px);
    margin: 0;
    display: flex;
    align-items: center;
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 48px;
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
  }
  .card-image {
    transition: transform 0.15s ease;
  }
  .card:hover .card-image,
  .card:focus-visible .card-image {
    transform: translateY(-3px);
  }
  .card-title {
    width: 100%;
    text-align: center;
    color: var(--heading);
    font-weight: 700;
    font-size: 1.05rem;
    padding-top: 10px;
    margin-top: 10px;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; gap: 28px; margin-bottom: 48px; }
    .hero-image { width: 100%; max-width: 380px; justify-self: center; margin-right: 0; }
    .hero-note { position: static; width: auto; height: auto; justify-content: center; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
