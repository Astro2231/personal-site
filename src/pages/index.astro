---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`${site.name} — Portfolio`}>
  <header class="hero">
    <div class="hero-text">
      <h1>{site.name}</h1>
      <p>{site.intro}</p>
      <a class="button" href={`${base}resume/?download=1`}>Download resume</a>
    </div>
    {
      site.heroImage ? (
        <img class="hero-image" src={`${base}${site.heroImage}`} alt={site.heroImageAlt} />
      ) : (
        <div class="hero-image placeholder">Hero photo</div>
      )
    }
  </header>

  <section id="projects" aria-label="Projects">
    <ul class="grid">
      {
        projects.map((p) => (
          <li>
            <a class="card" href={`${base}projects/${p.slug}/`}>
              {p.image ? (
                <img class="card-image" src={`${base}${p.image}`} alt={p.imageAlt ?? ''} />
              ) : (
                <div class="card-image placeholder" aria-hidden="true" />
              )}
              <span class="card-title">{p.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    align-items: start;
    margin-bottom: 72px;
  }
  h1 {
    color: var(--accent);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    margin: 0 0 12px;
  }
  .hero-text p {
    margin: 0 0 24px;
    max-width: 34rem;
  }
  .hero-image {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px 48px;
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
  }
  .card-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    transition: transform 0.15s ease;
  }
  .card:hover .card-image,
  .card:focus-visible .card-image {
    transform: translateY(-3px);
  }
  .card-title {
    width: 100%;
    text-align: center;
    color: var(--heading);
    font-weight: 700;
    font-size: 1.05rem;
    padding-top: 10px;
    border-top: 2px solid var(--rule);
    margin-top: 10px;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; gap: 28px; margin-bottom: 48px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
