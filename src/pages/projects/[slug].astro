---
import Base from '../../layouts/Base.astro';
import { projects, type Project } from '../../data/projects';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`${project.title} — ${site.name}`}>
  <a class="back" href={`${base}#projects`}>← All projects</a>
  <h1>{project.title}</h1>
  {
    project.image ? (
      <img class="cover" src={`${base}${project.image}`} alt={project.imageAlt ?? ''} />
    ) : (
      <div class="cover placeholder">Coming soon</div>
    )
  }
  <article>
    {project.summary && <p>{project.summary}</p>}
  </article>
</Base>

<style>
  .back {
    color: var(--accent-text);
    text-decoration: none;
    font-weight: 600;
  }
  .back:hover { color: #fff; }
  h1 {
    color: var(--heading);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 16px 0 24px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--rule);
  }
  .cover {
    width: 100%;
    max-width: 820px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 28px;
  }
  article { max-width: 46rem; }
  .todo { font-style: italic; }
</style>
